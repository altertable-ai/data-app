{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "browser-tests",
    "dev",
    "examples/starter-data-app/index.tsx",
    "examples/annotation-host.tsx"
  ]
}
