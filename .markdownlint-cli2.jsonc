{
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": ["CHANGELOG.md"],
  "config": {
    "default": true,
    // Oxfmt owns whitespace, wrapping, and marker styles.
    "MD004": false,
    "MD007": false,
    "MD009": false,
    "MD010": false,
    "MD012": false,
    "MD013": false,
    "MD027": false,
    "MD030": false,
    "MD035": false,
    "MD046": false,
    "MD048": false,
    "MD049": false,
    "MD050": false,
    "MD055": false,
    "MD060": false,
  },
}
