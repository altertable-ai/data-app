{
  "name": "@altertable/data-app-bun",
  "version": "0.73.0",
  "description": "Local Bun servers, lakehouse access, and development previews for Altertable data apps.",
  "keywords": [
    "altertable",
    "analytics",
    "data-app",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/altertable-ai/data-app",
  "bugs": {
    "url": "https://github.com/altertable-ai/data-app/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Altertable",
    "url": "https://altertable.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altertable-ai/data-app.git",
    "directory": "packages/data-app-bun"
  },
  "bin": {
    "data-app-preview": "./bin/preview.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/types/preview/index.d.ts",
      "import": "./dist/preview/index.js"
    },
    "./reload": {
      "types": "./dist/types/reload-channel.d.ts",
      "import": "./dist/reload-channel.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts data-app-bun",
    "typecheck": "bun ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@altertable/data-app": "0.73.0",
    "@altertable/lakehouse": "0.4.1",
    "get-tsconfig": "4.14.3"
  },
  "devDependencies": {
    "@altertable/data-app-embed": "0.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
