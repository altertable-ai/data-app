{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "jsPlugins": ["./scripts/oxlint/no-runtime-assertion.ts"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "react/unsupported-syntax": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["./**", "../**", ".", ".."],
            "message": "Use repository-root @/ imports instead of relative imports."
          }
        ]
      }
    ],
    "func-style": [
      "error",
      "declaration",
      {
        "overrides": {
          "namedExports": "declaration"
        }
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": ["bun:test", "@playwright/test"],
            "patterns": [
              {
                "group": ["./**", "../**", ".", ".."],
                "message": "Use repository-root @/ imports for test fixtures."
              },
              {
                "group": [
                  "@/src/**",
                  "@/dev/**",
                  "**/dist/**",
                  "@altertable/data-app/dist/**"
                ],
                "message": "Test consumer workflows through @altertable/data-app/<entry>, not private implementation modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/vendor/d3-time/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/react/**"],
      "excludeFiles": [
        "src/react/actions.ts",
        "src/react/app-context.ts",
        "src/react/bindings.ts",
        "src/react/details.tsx",
        "src/react/exploration.ts",
        "src/react/source-owner.ts",
        "src/react/view-runtime.tsx",
        "src/react/view.ts",
        "src/react/ui/AboutData.tsx",
        "src/react/ui/Breakdown.tsx",
        "src/react/ui/Checkbox.tsx",
        "src/react/ui/CheckboxGroup.tsx",
        "src/react/ui/ChoicePicker.tsx",
        "src/react/ui/DimensionPicker.tsx",
        "src/react/ui/FunnelChart.tsx",
        "src/react/ui/JourneyChart.tsx",
        "src/react/ui/LiveControl.tsx",
        "src/react/ui/Ranking.tsx",
        "src/react/ui/RetentionChart.tsx",
        "src/react/ui/Select.tsx",
        "src/react/ui/TableWidget.tsx",
        "src/react/ui/chart-data.ts",
        "src/react/ui/csv-export.ts",
        "src/react/ui/data-context.ts",
        "src/react/ui/data-identifiers.tsx",
        "src/react/ui/story.ts",
        "src/react/ui/variables.ts",
        "src/react/ui/widget-views.ts"
      ],
      "rules": {
        "data-app/no-runtime-assertion": "error"
      }
    }
  ]
}
