{
  "name": "data-app-workspace",
  "version": "0.73.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/data-app-examples/templates/starter-local-data-app"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts && bun run scripts/build-reference.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:file": "bun run scripts/dev-file.ts",
    "dev:dir": "bun run scripts/dev-dir.ts",
    "typecheck": "tsc --noEmit && bun run --filter '@altertable/*' typecheck",
    "lint": "oxlint --type-aware packages/*/src packages/data-app-examples/templates/starter-data-app tests scripts dev vitest.config.ts knip.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "bun run build && bun run check:boundaries && bun run typecheck && bun run lint && bun run knip && bun run check:styles && bun run lint:md && bun run check:links && bun run format:check && bun run test && bun run check:reference && bun run check:package && bun run check:starter",
    "check:package": "bun run scripts/check-package.ts",
    "check:workflows": "bash scripts/check-workflows.sh",
    "lint:fix": "oxlint --type-aware --fix packages/*/src packages/data-app-examples/templates/starter-data-app tests scripts dev vitest.config.ts knip.ts",
    "check:starter": "bun run scripts/check-starter.ts",
    "lint:md": "markdownlint-cli2",
    "check:links": "remark . --ext md --rc-path .remarkrc.json --frail --no-stdout",
    "check:links:external": "remark . --ext md --rc-path .remarkrc-external.json --frail --no-stdout",
    "check:styles": "bun run scripts/check-app-styles.ts",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check:reference": "bun run scripts/build-reference.ts --check",
    "test:watch": "vitest",
    "knip": "knip"
  },
  "devDependencies": {
    "@altertable/data-app": "0.73.0",
    "@altertable/data-app-bun": "0.73.0",
    "@altertable/data-app-embed": "0.73.0",
    "@altertable/data-app-examples": "0.73.0",
    "@altertable/data-app-manifest": "0.73.0",
    "@altertable/data-app-react": "0.73.0",
    "@altertable/data-app-worker": "0.73.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "get-tsconfig": "4.14.3",
    "knip": "6.41.0",
    "lucide-react": "1.59.0",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "remark-cli": "12.0.1",
    "remark-gfm": "4.0.1",
    "remark-lint-no-dead-urls": "2.0.1",
    "remark-validate-links": "13.1.0",
    "testcontainers": "12.2.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.3"
}
